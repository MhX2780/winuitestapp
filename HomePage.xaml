<Page
    x:Class="AdvaBrowser.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AdvaBrowser">

    <Page.Resources>
        <!-- Code block style (for future use) -->
        <Style x:Key="CodeBlockStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
    </Page.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Top Bar ═══ -->
        <Grid Grid.Row="0" Padding="16,12,16,8" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="Chat" FontSize="28" FontWeight="Bold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <ProgressRing x:Name="ThinkingRing" IsActive="False" Visibility="Collapsed"
                              Width="24" Height="24"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock x:Name="StatusText" Text="Ready" FontSize="12"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="&#xE7E7;" Click="Undo_Click" ToolTipService.ToolTip="Undo last agent change"
                        FontFamily="Segoe MDL2 Assets" Width="36" Height="36" Padding="0"
                        Style="{ThemeResource ButtonRevealStyle}"/>
                <Button Content="&#xE74D;" Click="ClearChat_Click" ToolTipService.ToolTip="Clear chat history"
                        FontFamily="Segoe MDL2 Assets" Width="36" Height="36" Padding="0"
                        Style="{ThemeResource ButtonRevealStyle}"/>
                <Button Content="&#xE8E5;" Click="NewChat_Click" ToolTipService.ToolTip="Start new conversation"
                        FontFamily="Segoe MDL2 Assets" Width="36" Height="36" Padding="0"
                        Style="{ThemeResource ButtonRevealStyle}"/>
            </StackPanel>
        </Grid>

        <!-- ═══ Chat Messages ═══ -->
        <ListView x:Name="ChatListView" Grid.Row="1" Padding="16,8,16,16"
                  SelectionMode="None" IsItemClickEnabled="False"
                  HorizontalContentAlignment="Stretch" VerticalAlignment="Stretch">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0,2,0,2"/>
                    <Setter Property="Margin" Value="0"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ChatMessage">
                    <Grid Padding="4,2">
                        <!-- User message bubble (right-aligned) -->
                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="12,12,4,12" Padding="14,10"
                                HorizontalAlignment="Right" MaxWidth="680" Margin="40,0,0,0">
                            <Border.Visibility>
                                <Binding Path="Role" Converter="{StaticResource RoleToVisibilityConverter}" ConverterParameter="user"/>
                            </Border.Visibility>
                            <TextBlock Text="{x:Bind Content}" TextWrapping="Wrap" FontSize="14"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </Border>

                        <!-- Model / System message bubble (left-aligned) -->
                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12,12,12,4" Padding="14,10"
                                HorizontalAlignment="Left" MaxWidth="680" Margin="0,0,40,0">
                            <Border.Visibility>
                                <Binding Path="Role" Converter="{StaticResource RoleToVisibilityConverter}" ConverterParameter="model"/>
                            </Border.Visibility>
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind ModelName}" FontSize="11"
                                           Foreground="{ThemeResource SystemFillColorSuccessBrush}" Opacity="0.8"/>
                                <TextBlock Text="{x:Bind Content}" TextWrapping="Wrap" FontSize="14"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Tool call indicator (center) -->
                        <Border CornerRadius="8" Padding="10,6" HorizontalAlignment="Center"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorTertiaryBrush}" MaxWidth="520">
                            <Border.Visibility>
                                <Binding Path="IsToolCall" Converter="{StaticResource BoolToVisibilityConverter}"/>
                            </Border.Visibility>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE930;" FontSize="14"
                                          Foreground="{ThemeResource SystemFillColorAttentionBrush}"/>
                                <TextBlock Text="{x:Bind Content}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- ═══ Welcome Panel ═══ -->
        <StackPanel x:Name="WelcomePanel" Grid.Row="1"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="16" MaxWidth="520">
            <FontIcon Glyph="&#xE945;" FontSize="64" HorizontalAlignment="Center"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            <TextBlock Text="UGA" FontSize="48" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="Unofficial Gemini Agent" FontSize="16"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="Type a message below to start chatting with Gemini. The agent can create, edit, and manage files in your workspace."
                       FontSize="13" TextWrapping="Wrap" HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,8,0,0"/>
            <TextBlock Text="File tools | Git | Search | Multi-Agent Mode | Undo | Memory"
                       FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" Opacity="0.6"/>
        </StackPanel>

        <!-- ═══ Input Area ═══ -->
        <Grid Grid.Row="2" Padding="16,8,16,16" Background="Transparent">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InputTextBox"
                             PlaceholderText="Type your message..."
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MaxHeight="150" MinHeight="44"
                             KeyDown="InputTextBox_KeyDown" FontSize="14"
                             Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                    <Button Grid.Column="1" x:Name="SendButton"
                            Click="SendButton_Click"
                            Style="{ThemeResource AccentButtonStyle}"
                            MinWidth="100" MinHeight="44"
                            VerticalAlignment="Bottom" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE724;" FontSize="14"/>
                            <TextBlock Text="Send"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock Grid.Row="1" Text="Ctrl+Enter to send | Enter for new line"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" Opacity="0.7"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
