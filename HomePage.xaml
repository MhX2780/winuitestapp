<Page
    x:Class="UGA.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UGA">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Grid Grid.Row="0" Padding="16,12,16,8" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="Chat" FontSize="22" FontWeight="Bold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <TextBlock x:Name="ModelStatusText" Text="" FontSize="11"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Text="Ready" FontSize="12"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Chat Messages -->
        <ListView x:Name="ChatListView" Grid.Row="1" Padding="16,8,16,16"
                  SelectionMode="None" IsItemClickEnabled="False"
                  HorizontalContentAlignment="Stretch" VerticalAlignment="Stretch">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0,3,0,3"/>
                    <Setter Property="Margin" Value="0"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel VerticalAlignment="Bottom"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ChatMessage">
                    <Grid Padding="4,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- User message bubble (right-aligned) -->
                        <Border Grid.Row="0"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="12,12,4,12" Padding="14,10"
                                HorizontalAlignment="Right" MaxWidth="700" Margin="60,0,0,0">
                            <Border.Visibility>
                                <Binding Path="Role" Converter="{StaticResource RoleToVisibilityConverter}" ConverterParameter="user"/>
                            </Border.Visibility>
                            <TextBlock Text="{x:Bind Content}" TextWrapping="Wrap" FontSize="15"
                                       Foreground="Black"/>
                        </Border>

                        <!-- Model response (left-aligned, with Markdown) -->
                        <StackPanel Grid.Row="1" HorizontalAlignment="Left" MaxWidth="700" Margin="0,0,60,0">
                            <StackPanel.Visibility>
                                <Binding Path="Role" Converter="{StaticResource RoleToVisibilityConverter}" ConverterParameter="model"/>
                            </StackPanel.Visibility>
                            <TextBlock Text="{x:Bind ModelName}" FontSize="11"
                                       Foreground="{ThemeResource SystemFillColorSuccessBrush}" Opacity="0.7"/>
                            <RichTextBlock x:Name="ModelRichText" TextWrapping="Wrap" FontSize="15"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           Loaded="ModelRichText_Loaded"
                                           DataContextChanged="ModelRichText_DataContextChanged"/>
                        </StackPanel>

                        <!-- Tool call RUNNING card -->
                        <Border Grid.Row="2"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8" Padding="12,10"
                                HorizontalAlignment="Left" MaxWidth="700" Margin="0,0,60,0">
                            <Border.Visibility>
                                <Binding Path="IsToolRunning" Converter="{StaticResource BoolToVisibilityConverter}"/>
                            </Border.Visibility>
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ProgressRing Width="16" Height="16"
                                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                    <TextBlock Text="{x:Bind ToolName}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{x:Bind Content}" FontSize="12" Opacity="0.7"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="24,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- System action consolidated card -->
                        <Border Grid.Row="3"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                                BorderThickness="1"
                                CornerRadius="8" Padding="12,10"
                                HorizontalAlignment="Left" MaxWidth="700" Margin="0,2,60,0">
                            <Border.Visibility>
                                <Binding Path="IsSystemAction" Converter="{StaticResource BoolToVisibilityConverter}"/>
                            </Border.Visibility>
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE73E;" FontSize="16"
                                              Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Text="Actions Completed" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{x:Bind ActionItems}" Margin="24,2,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="12" Opacity="0.8"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                       Margin="0,2,0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Multi-agent task list card -->
                        <Border Grid.Row="4"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8" Padding="12,10"
                                HorizontalAlignment="Left" MaxWidth="700" Margin="0,2,60,0">
                            <Border.Visibility>
                                <Binding Path="IsTaskList" Converter="{StaticResource BoolToVisibilityConverter}"/>
                            </Border.Visibility>
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="16"
                                              Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind Content}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{x:Bind TaskItems}" Margin="24,2,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,3,0,3">
                                                <FontIcon x:Name="TaskIcon" Glyph="&#xE73E;" FontSize="14"
                                                          Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                          VerticalAlignment="Center"/>
                                                <ProgressRing x:Name="TaskSpinner" Width="14" Height="14"
                                                              Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                              IsActive="True"
                                                              VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Description}" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Deep Thinking card -->
                        <Border Grid.Row="5"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource SystemFillColorAttentionBrush}"
                                BorderThickness="1"
                                CornerRadius="8" Padding="12,10"
                                HorizontalAlignment="Left" MaxWidth="700" Margin="0,2,60,0">
                            <Border.Visibility>
                                <Binding Path="IsDeepThinking" Converter="{StaticResource BoolToVisibilityConverter}"/>
                            </Border.Visibility>
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE945;" FontSize="16"
                                              Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Text="Deep Thinking" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <ProgressRing Width="14" Height="14" Foreground="{ThemeResource SystemFillColorAttentionBrush}">
                                        <ProgressRing.Visibility>
                                            <Binding Path="IsStreaming" Converter="{StaticResource BoolToVisibilityConverter}"/>
                                        </ProgressRing.Visibility>
                                    </ProgressRing>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ThinkingContent}" FontSize="12" Opacity="0.8"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="22,0,0,0"/>
                            </StackPanel>
                        </Border>

                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Welcome Panel -->
        <StackPanel x:Name="WelcomePanel" Grid.Row="1"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="16" MaxWidth="520">
            <FontIcon Glyph="&#xE945;" FontSize="64" HorizontalAlignment="Center"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            <TextBlock Text="UGA" FontSize="48" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            <TextBlock Text="Unofficial Gemini Agent" FontSize="16"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="Type a message below to start chatting with Gemini. The agent can create, edit, and manage files in your workspace."
                       FontSize="13" TextWrapping="Wrap" HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,8,0,0"/>
            <TextBlock Text="File tools | Git | Search | Multi-Agent Mode | Undo | Memory"
                       FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" Opacity="0.6"/>
        </StackPanel>

        <!-- Input Area -->
        <Grid Grid.Row="2" Padding="16,8,16,16" Background="Transparent">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InputTextBox"
                             PlaceholderText="Type your message..."
                             AcceptsReturn="False" TextWrapping="Wrap"
                             MaxHeight="150" MinHeight="44"
                             KeyDown="InputTextBox_KeyDown" FontSize="15"
                             Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                    <Grid Grid.Column="1" MinWidth="100" MinHeight="44" VerticalAlignment="Bottom">
                        <Button x:Name="SendButton"
                                Click="SendButton_Click"
                                Style="{ThemeResource AccentButtonStyle}"
                                MinWidth="100" MinHeight="44" CornerRadius="8"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE724;" FontSize="14"/>
                                <TextBlock Text="Send"/>
                            </StackPanel>
                        </Button>
                        <ProgressRing x:Name="SendProgressRing" IsActive="False" Visibility="Collapsed"
                                      Width="28" Height="28"
                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
                <TextBlock Grid.Row="1" Text="Enter to send | Shift+Enter for new line"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" Opacity="0.7"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
