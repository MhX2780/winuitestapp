<Window
    x:Class="AdvaBrowser.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AdvaBrowser"
    Title="UGA">

    <NavigationView
        x:Name="RootNav"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        PaneDisplayMode="Left"
        SelectionChanged="RootNav_SelectionChanged"
        Loaded="RootNav_Loaded"
        OpenPaneLength="260"
        CompactPaneLength="48"
        Background="Transparent"
        IsPaneToggleButtonVisible="True"
        IsTitleBarAutoPaddingEnabled="False"
        AlwaysShowHeader="False"
        CompactModeThresholdWidth="640"
        ExpandedModeThresholdWidth="641">

        <NavigationView.MenuItems>
            <NavigationViewItem Content="Chat" Tag="home" ToolTipService.ToolTip="Home">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Message" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="Settings" Tag="settings" ToolTipService.ToolTip="Settings">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Setting" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Grid>
            <Frame x:Name="ContentFrame" />
        </Grid>
    </NavigationView>
</Window>
