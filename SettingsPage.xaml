<Page
    x:Class="UGA.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UGA">

    <Grid Background="Transparent">
        <!-- Loading Spinner Overlay -->
        <Grid x:Name="LoadingOverlay" Background="Transparent"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Visibility="Visible">
            <StackPanel Spacing="16" HorizontalAlignment="Center">
                <ProgressRing IsActive="True" Width="48" Height="48"
                              Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                <TextBlock Text="Loading settings..." FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="SettingsScroll" Padding="32,24,32,32" Background="Transparent"
                     HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
        <StackPanel Spacing="24" MaxWidth="800" HorizontalAlignment="Stretch">

            <!-- ═══ API Key ═══ -->
            <TextBlock Text="API Configuration" FontSize="22" FontWeight="Bold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Gemini API Key" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <PasswordBox x:Name="ApiKeyBox" PlaceholderText="Enter API key..."
                                 Width="400"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SaveKeyButton" Content="Save Key" Click="SaveKey_Click"
                                Style="{ThemeResource AccentButtonStyle}" CornerRadius="6"/>
                        <Button x:Name="ResetKeyButton" Content="Reset Key" Click="ResetKey_Click" CornerRadius="6"/>
                    </StackPanel>
                    <TextBlock x:Name="KeyStatus" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- ═══ Model Selection ═══ -->
            <TextBlock Text="Model Configuration" FontSize="22" FontWeight="Bold" Margin="0,12,0,0"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Primary Model" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <ComboBox x:Name="ModelCombo" Width="400" CornerRadius="6"/>
                    <TextBlock Text="Model Chain (click items to edit, or use dropdowns below)"
                               FontWeight="SemiBold" Margin="0,8,0,0"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <BreadcrumbBar x:Name="ModelChainBreadcrumb" Margin="0,4,0,0"/>
                    <Grid ColumnSpacing="8" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="AddModelCombo" Width="300" CornerRadius="6" PlaceholderText="Add model to chain..."/>
                        <Button x:Name="AddModelBtn" Grid.Column="1" Content="+" Click="AddModelBtn_Click" CornerRadius="6" Width="40"/>
                        <Button x:Name="RemoveLastModelBtn" Grid.Column="2" Content="-" Click="RemoveLastModelBtn_Click" CornerRadius="6" Width="40" ToolTipService.ToolTip="Remove last model from chain"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══ Workspace ═══ -->
            <TextBlock Text="Workspace" FontSize="22" FontWeight="Bold" Margin="0,12,0,0"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="WorkspaceBox"
                                 PlaceholderText="Workspace directory path..."
                                 TextWrapping="Wrap"/>
                        <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse" Click="Browse_Click"
                                CornerRadius="6"/>
                    </Grid>
                    <TextBlock x:Name="WorkspaceStatus" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- ═══ Appearance ═══ -->
            <TextBlock Text="Appearance" FontSize="22" FontWeight="Bold" Margin="0,12,0,0"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Application Theme" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <ComboBox x:Name="ThemeCombo" Width="300" SelectedIndex="0" CornerRadius="6"
                              SelectionChanged="ThemeCombo_SelectionChanged">
                        <ComboBoxItem Content="System Default (Auto)" Tag="auto"/>
                        <ComboBoxItem Content="Dark" Tag="dark"/>
                        <ComboBoxItem Content="Light" Tag="light"/>
                    </ComboBox>
                    <TextBlock x:Name="ThemeStatus" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- ═══ Tools ═══ -->
            <TextBlock Text="Tools" FontSize="22" FontWeight="Bold" Margin="0,12,0,0"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="10">
                    <ToggleSwitch x:Name="FileTools" Header="File Tools" IsOn="True"
                                  ToolTipService.ToolTip="create_file, read_file, edit_file, delete_file, move, copy, rename, create_folder"/>
                    <ToggleSwitch x:Name="SearchTools" Header="Search Tools" IsOn="True"
                                  ToolTipService.ToolTip="find_file, find_folder, search_in_files, list_files, detect_language, file_stats, count_files, count_todos"/>
                    <ToggleSwitch x:Name="GitTools" Header="Git Tools" IsOn="True"
                                  ToolTipService.ToolTip="git_clone, git_status, git_diff, git_log, git_commit"/>
                    <ToggleSwitch x:Name="ExecTools" Header="Execution Tools" IsOn="True"
                                  ToolTipService.ToolTip="run_command, create_zip, extract_zip, zip_workspace, undo_last_change"/>
                    <ToggleSwitch x:Name="CodeTools" Header="Code Quality Tools" IsOn="True"
                                  ToolTipService.ToolTip="lint_check, diff_preview, compare_files, replace_in_files"/>
                    <ToggleSwitch x:Name="NetworkTools" Header="Networking Tools" IsOn="False"
                                  ToolTipService.ToolTip="check_port_in_use, http_request"/>
                    <ToggleSwitch x:Name="SystemTools" Header="System Access Tools" IsOn="False"
                                  ToolTipService.ToolTip="Available_Active_Windows, List_System_Processes (SENSITIVE)"/>
                </StackPanel>
            </Border>

            <!-- ═══ Multi-Agent ═══ -->
            <TextBlock Text="Multi-Agent Mode" FontSize="22" FontWeight="Bold" Margin="0,12,0,0"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <ToggleSwitch x:Name="MultiAgent" Header="Enable Multi-Agent" IsOn="False"
                                  ToolTipService.ToolTip="Classifier -&gt; Planner -&gt; Executor -&gt; Reviewer"/>
                    <TextBlock Text="Classifier Model" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    <ComboBox x:Name="ClassifierCombo" Width="400" CornerRadius="6"/>
                    <TextBlock Text="Planner Model" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    <ComboBox x:Name="PlannerCombo" Width="400" CornerRadius="6"/>
                    <TextBlock Text="Executor Model" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    <ComboBox x:Name="ExecutorCombo" Width="400" CornerRadius="6"/>
                    <TextBlock Text="Reviewer Model" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    <ComboBox x:Name="ReviewerCombo" Width="400" CornerRadius="6"/>
                </StackPanel>
            </Border>

            <!-- ═══ Deep Thinking ═══ -->
            <TextBlock Text="Deep Thinking" FontSize="22" FontWeight="Bold" Margin="0,12,0,0"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <ToggleSwitch x:Name="DeepThinking" Header="Enable Deep Thinking" IsOn="False"
                                  ToolTipService.ToolTip="Uses extra reasoning tokens before answering"/>
                    <NumberBox x:Name="ThinkBudget" Header="Thinking Budget (-1 = dynamic)"
                               Value="-1" Minimum="-1" Maximum="65536" Width="200"/>
                    <ToggleSwitch x:Name="ThinkInclude" Header="Include Thought Summaries" IsOn="True"/>
                </StackPanel>
            </Border>

            <!-- ═══ Providers ═══ -->
            <TextBlock Text="Additional Providers" FontSize="22" FontWeight="Bold" Margin="0,12,0,0"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Claude (Anthropic) API Key" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <PasswordBox x:Name="ClaudeKeyBox" PlaceholderText="sk-ant-..." Width="400"/>
                    <TextBlock Text="OpenAI API Key" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <PasswordBox x:Name="OpenAIKeyBox" PlaceholderText="sk-..." Width="400"/>
                    <TextBlock Text="Puter.js Token" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <PasswordBox x:Name="PuterTokenBox" PlaceholderText="Puter auth token..." Width="400"/>
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="Get a free token at puter.com/dashboard#account → Create token."/>
                </StackPanel>
            </Border>

            <!-- ═══ Puter.js Settings ═══ -->
            <TextBlock Text="Puter.js Integration" FontSize="22" FontWeight="Bold" Margin="0,12,0,0"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="10">
                    <ToggleSwitch x:Name="PuterChat" Header="Puter.js Chat (route main chat through Puter)" IsOn="False"
                                  ToolTipService.ToolTip="When ON, chat goes through Puter's free models instead of Gemini."/>
                    <ToggleSwitch x:Name="PuterFreeOnly" Header="Free Models Only" IsOn="True"
                                  ToolTipService.ToolTip="Only allow Puter models with 'free' in the name."/>
                    <ToggleSwitch x:Name="PuterToolCalling" Header="Puter Tool Calling (BETA)" IsOn="False"
                                  ToolTipService.ToolTip="Let Puter models call all workspace tools (best-effort, may not work with all models)."/>
                    <ToggleSwitch x:Name="PuterImageTools" Header="Puter Image Tools (BETA)" IsOn="False"
                                  ToolTipService.ToolTip="Enable Puter.js fallback for Image_Fetch and Image_Create."/>
                    <ToggleSwitch x:Name="PuterDeepThinking" Header="Puter Deep Thinking" IsOn="False"
                                  ToolTipService.ToolTip="Enable reasoning_effort parameter for reasoning-capable Puter models."/>
                    
                    <TextBlock Text="Puter Chat Model" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <ComboBox x:Name="PuterModelBox" Width="400" CornerRadius="6" PlaceholderText="Select Puter chat model..."/>
                    
                    <TextBlock Text="Puter Vision Model (Image_Fetch_Puter)" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    <ComboBox x:Name="PuterVisionBox" Width="400" CornerRadius="6" PlaceholderText="Select Puter vision model..."/>
                    
                    <TextBlock Text="Puter Image Gen Model (Image_Create_Puter)" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    <ComboBox x:Name="PuterImageGenBox" Width="400" CornerRadius="6" PlaceholderText="Select Puter image gen model..."/>
                    
                    <ComboBox x:Name="PuterEffortCombo" Header="Deep Thinking Effort" Width="200" SelectedIndex="2" CornerRadius="6">
                        <ComboBoxItem Content="low" Tag="low"/>
                        <ComboBoxItem Content="medium" Tag="medium"/>
                        <ComboBoxItem Content="high" Tag="high"/>
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button x:Name="ListPuterModelsButton" Content="List Puter Models" Click="ListPuterModels_Click" CornerRadius="6"/>
                        <Button x:Name="ListFreeModelsButton" Content="List Free Models" Click="ListFreeModels_Click" CornerRadius="6"/>
                    </StackPanel>
                    <TextBlock x:Name="PuterModelsStatus" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- ═══ Memory & System Prompt ═══ -->
            <TextBlock Text="Memory &amp; Prompt" FontSize="22" FontWeight="Bold" Margin="0,12,0,0"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Custom System Prompt Override (empty = use default)"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBox x:Name="SystemPromptBox" PlaceholderText="Leave empty for default..."
                             AcceptsReturn="True" TextWrapping="Wrap"
                             Height="100" Width="600" HorizontalAlignment="Left"/>
                    <NumberBox x:Name="MaxHistory" Header="Max History Messages"
                               Value="30" Minimum="5" Maximum="200" Width="200"/>
                </StackPanel>
            </Border>

            <!-- ═══ Save / Reset ═══ -->
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
                <Button x:Name="SaveAllButton" Content="Save All Settings" Click="SaveAll_Click"
                        Style="{ThemeResource AccentButtonStyle}" MinWidth="160" CornerRadius="6"/>
                <Button x:Name="ResetDefaultsButton" Content="Reset to Defaults" Click="ResetDefaults_Click" CornerRadius="6"/>
                <Button x:Name="ShowLogsButton" Content="Show Logs" Click="ShowLogs_Click" CornerRadius="6"
                        ToolTipService.ToolTip="Open the log file location"/>
            </StackPanel>
            <TextBlock x:Name="SaveStatus" FontSize="13"
                       Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
            <TextBlock x:Name="LogPathText" FontSize="11" Margin="0,4,0,0"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</Page>
